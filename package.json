{
  "name": "dmedic",
  "version": "1.3.0",
  "description": "Sistema de gestion clinica DMedic",
  "main": "./out/main/index.js",
  "author": "DMedic",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verificar": "electron-vite build && electron out/main/verificar.js",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml --publish never",
    "publicar": "npm run build && electron-builder --win --config electron-builder.yml --publish always",
    "publicador": "electron publicador"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "zod": "^3.25.0"
  }
}
